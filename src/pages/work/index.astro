---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.tier - b.data.tier || b.data.dates.start.localeCompare(a.data.dates.start),
);
const tags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();
---
<Base title="Work" description="Case studies in digital twins, real-time 3D, XR and tooling.">
  <h1>Work</h1>
  <p class="lead">Case studies across digital twins, real-time 3D / XR and tools. Also see <a href="/work/media">media & 3D models</a>.</p>

  <div class="filters" role="group" aria-label="Filter by tag">
    <button type="button" data-tag="" aria-pressed="true">All</button>
    {tags.map((t) => <button type="button" data-tag={t} aria-pressed="false">{t}</button>)}
  </div>

  <div class="grid" id="projects">{projects.map((p) => <ProjectCard project={p} />)}</div>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const cards = document.querySelectorAll<HTMLElement>('#projects [data-tags]');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag ?? '';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      cards.forEach((c) => {
        c.hidden = tag !== '' && !(c.dataset.tags ?? '').split('|').includes(tag);
      });
    }),
  );
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.5rem 0; }
  .filters button {
    font: inherit; font-size: 0.85rem; padding: 0.25rem 0.75rem; border-radius: 999px;
    border: 1px solid var(--border); background: var(--surface); color: var(--text); cursor: pointer;
  }
  .filters button[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  @media (max-width: 40rem) {
    /* 30-odd tags would fill a whole phone screen: scroll them sideways instead. */
    .filters {
      flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch;
      margin-inline: -1rem; padding-inline: 1rem; scroll-padding-inline: 1rem;
      mask-image: linear-gradient(to right, #000 85%, transparent);
    }
    .filters::-webkit-scrollbar { display: none; }
    .filters button { flex: none; padding: 0.45rem 0.9rem; }
  }
</style>

---
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';
---
<footer class="container site-footer">
  <SocialLinks />
  <p class="muted">{site.location}</p>
  <p><a href="/how-this-site-is-built">How this site is built</a></p>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--border); margin-top: 5rem; padding-block: 2rem; font-size: 0.9rem; }
  .site-footer p { margin: 0.75rem 0 0; }
</style>

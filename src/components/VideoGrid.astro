---
import { Image } from 'astro:assets';
import { videoLength, videoYear, type Video } from '../data/vimeo';

interface Props { videos: Video[] }
const { videos } = Astro.props;
---
<ul class="video-grid">
  {videos.map((video) => (
    <li>
      <figure class="video" data-embed={video.embed} data-title={video.title}>
        <button type="button" class="play" aria-label={`Play ${video.title}`}>
          {video.thumb ? (
            <Image src={video.thumb} alt="" widths={[480, 960]} sizes="(max-width: 48rem) 100vw, 30rem" loading="lazy" />
          ) : (
            <span class="no-thumb" aria-hidden="true"></span>
          )}
          <span class="badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
          </span>
          <span class="length" aria-hidden="true">{videoLength(video.duration)}</span>
        </button>
        <figcaption>
          <strong>{video.title}</strong>
          <span class="muted year">{videoYear(video)}</span>
          {video.blurb && <span class="muted blurb">{video.blurb}</span>}
        </figcaption>
      </figure>
    </li>
  ))}
</ul>

<script>
  // Swap the thumbnail for the real player only when someone presses play, so the
  // page loads no third-party iframes and no Vimeo requests happen before then.
  document.querySelectorAll<HTMLElement>('.video').forEach((figure) => {
    const button = figure.querySelector('button.play');
    button?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = figure.dataset.embed ?? '';
      frame.title = figure.dataset.title ?? 'Video';
      frame.allow = 'autoplay; fullscreen; picture-in-picture';
      frame.allowFullscreen = true;
      frame.loading = 'lazy';
      button.replaceWith(frame);
    });
  });
</script>

<style>
  .video-grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); list-style: none; padding: 0; margin: 1.5rem 0 0; }
  .video { margin: 0; }
  .play {
    position: relative; display: block; width: 100%; padding: 0; border: 0; cursor: pointer;
    background: var(--border); border-radius: var(--radius); overflow: hidden; aspect-ratio: 16 / 9;
  }
  .play :global(img), .no-thumb { width: 100%; height: 100%; object-fit: cover; display: block; transition: opacity 0.2s; }
  .play:hover :global(img) { opacity: 0.85; }
  .badge {
    position: absolute; inset: 0; margin: auto; width: 3.25rem; height: 3.25rem; display: grid; place-items: center;
    border-radius: 999px; background: rgb(0 0 0 / 0.55); color: #fff; backdrop-filter: blur(2px);
  }
  .play:hover .badge { background: var(--accent); color: var(--accent-ink); }
  .play:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .length {
    position: absolute; right: 0.5rem; bottom: 0.5rem; font-size: 0.75rem; font-variant-numeric: tabular-nums;
    padding: 0.1rem 0.4rem; border-radius: 4px; background: rgb(0 0 0 / 0.65); color: #fff;
  }
  .video :global(iframe) { width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: var(--radius); display: block; }
  figcaption { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem; margin-top: 0.5rem; font-size: 0.95rem; }
  .year { font-variant-numeric: tabular-nums; }
  .blurb { flex-basis: 100%; font-size: 0.9rem; }
</style>

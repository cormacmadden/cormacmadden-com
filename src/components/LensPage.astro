---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from './ProjectCard.astro';
import ArtCard from './ArtCard.astro';
import { artProjects } from '../data/artstation';
import { lenses, type LensId } from '../data/lenses';

interface Props { id: LensId }
const lens = lenses[Astro.props.id];
const all = await getCollection('projects', ({ data }) => !data.draft);
// Curated list: case-study slugs, or 'media/<slug>' for a Media & 3D (ArtStation) post.
type Item = { kind: 'project'; project: (typeof all)[number] } | { kind: 'art'; art: (typeof artProjects)[number] };
const ordered: Item[] = lens.projects.flatMap((slug): Item[] => {
  if (slug.startsWith('media/')) {
    const art = artProjects.find((a) => a.slug === slug.slice('media/'.length));
    return art ? [{ kind: 'art', art }] : [];
  }
  const project = all.find((p) => p.id === slug);
  return project ? [{ kind: 'project', project }] : [];
});
// Any other project tagged with this lens goes after the curated list.
const extra: Item[] = all
  .filter((p) => p.data.lenses.includes(lens.id) && !lens.projects.includes(p.id))
  .map((project) => ({ kind: 'project', project }));
const items = [...ordered, ...extra];
---
<Base title={lens.title} description={lens.intro}>
  <p class="muted">{lens.kicker}</p>
  <h1>{lens.title}</h1>
  <p class="lead">{lens.intro}</p>
  <div class="actions">
    <a class="btn" href="/work">All work</a>
  </div>
  {lens.context && (
    <section class="context">
      <h2>{lens.context.heading}</h2>
      {lens.context.paragraphs.map((para) => <p class="context-note">{para}</p>)}
      <div class="context-groups">
        {lens.context.groups.map((g) => (
          <div class="card context-group">
            <h3>{g.title}</h3>
            <ul>{g.items.map((item) => <li>{item}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>
  )}
  <h2>Projects</h2>
  <div class="grid">
    {items.map((item) => (item.kind === 'project' ? <ProjectCard project={item.project} /> : <ArtCard art={item.art} />))}
  </div>
</Base>

<style>
  .context-note { max-width: 46rem; margin: 0 0 0.75rem; }
  .context-groups { display: grid; gap: 1rem; margin-top: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 30rem), 1fr)); }
  .context-group h3 { margin: 0 0 0.6rem; font-size: 1.05rem; }
  .context-group ul { margin: 0; padding-left: 1.1rem; }
  .context-group li { margin: 0.3rem 0; color: var(--muted); }
</style>

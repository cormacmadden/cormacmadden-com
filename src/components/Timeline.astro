---
import ThemedImage from './ThemedImage.astro';
import { timeline, type TimelineItem } from '../data/timeline';
import { logos, type Logo } from '../data/icons';

interface Props { kind: TimelineItem['kind'] }
const items = timeline.filter((item) => item.kind === Astro.props.kind);
---
<ol class="timeline">
  {items.map((item) => {
    const logo: Logo | undefined = item.logo ? logos[item.logo] : undefined;
    const Row = item.body?.length ? 'details' : 'div';
    return (
      <li>
        <Row class="entry">
          {item.body?.length ? (
            <summary>
              <span class="logo">
                {logo ? (
                  <ThemedImage src={logo.src} dark={logo.dark} alt={logo.alt} height={96} />
                ) : (
                  <span class="initials" aria-hidden="true">{item.org.split(/[\s,/]+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('')}</span>
                )}
              </span>
              <span class="what">
                <strong>{item.title}</strong>
                <span class="org">{item.org}</span>
                {item.detail && <span class="muted detail">{item.detail}</span>}
              </span>
              <span class="when muted">{item.when}</span>
              <svg class="chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </summary>
          ) : (
            <div class="summary-static">
              <span class="logo">
                {logo ? (
                  <ThemedImage src={logo.src} dark={logo.dark} alt={logo.alt} height={96} />
                ) : (
                  <span class="initials" aria-hidden="true">{item.org.split(/[\s,/]+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('')}</span>
                )}
              </span>
              <span class="what">
                <strong>{item.title}</strong>
                <span class="org">{item.org}</span>
                {item.detail && <span class="muted detail">{item.detail}</span>}
              </span>
              <span class="when muted">{item.when}</span>
            </div>
          )}
          {item.body?.length ? (
            <div class="body">
              {item.body.map((para) => <p>{para}</p>)}
            </div>
          ) : null}
        </Row>
      </li>
    );
  })}
</ol>

<style>
  .timeline { list-style: none; padding: 0; margin: 0; }
  li { border-bottom: 1px solid var(--border); }

  summary, .summary-static {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto 1.25rem;
    grid-template-areas: 'logo what when chev';
    gap: 1rem;
    align-items: center;
    padding: 0.9rem 0;
  }
  .summary-static { grid-template-columns: 3.5rem minmax(0, 1fr) auto; grid-template-areas: 'logo what when'; }
  .logo { grid-area: logo; }
  .what { grid-area: what; min-width: 0; }
  .when { grid-area: when; }
  .chevron { grid-area: chev; }
  summary { cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:hover strong, details[open] > summary strong { text-decoration: underline; text-underline-offset: 3px; }

  .logo { width: 3.5rem; height: 3.5rem; display: grid; place-items: center; }
  .logo :global(picture) { display: contents; }
  .logo :global(img) { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
  .initials { font-size: 1rem; font-weight: 700; color: var(--muted); }

  .what { display: flex; flex-direction: column; }
  .detail { font-size: 0.9rem; }
  .when { font-size: 0.9rem; font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
  .chevron { color: var(--muted); transition: transform 0.2s ease; justify-self: end; }
  details[open] > summary .chevron { transform: rotate(180deg); }

  .body { padding: 0 0 1.25rem 4.5rem; max-width: 60rem; }
  .body p { margin: 0 0 0.75rem; color: var(--muted); }
  .body p:last-child { margin-bottom: 0; }

  /* Phones: logo | title, org and dates stacked | chevron. */
  @media (max-width: 40rem) {
    summary, .summary-static {
      grid-template-columns: 2.75rem minmax(0, 1fr) 1.25rem;
      grid-template-areas: 'logo what chev' 'logo when chev';
      gap: 0.25rem 0.9rem;
      align-items: start;
    }
    .summary-static { grid-template-columns: 2.75rem minmax(0, 1fr); grid-template-areas: 'logo what' 'logo when'; }
    .logo { width: 2.75rem; height: 2.75rem; }
    .when { text-align: left; font-size: 0.85rem; }
    .chevron { align-self: center; }
    .body { padding-left: 0; }
  }
</style>
